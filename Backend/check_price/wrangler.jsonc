{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "check_price",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-01",
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "check_price_db",
			"database_id": "bcd30c94-63f2-4749-bbf0-64290acbe725",
			"migrations_dir": "drizzle"
		}
	],
	"ratelimits": [
		{
			"name": "LOGIN_RATE_LIMIT",
			"namespace_id": "1001",
			"simple": { "limit": 10, "period": 10 }
		},
		{
			"name": "API_RATE_LIMIT",
			"namespace_id": "1002",
			"simple": { "limit": 10, "period": 10 }
		},
		{
			"name": "API_ROLE_RATE_LIMIT",
			"namespace_id": "1003",
			"simple": { "limit": 10, "period": 10 }
		},
		{
			"name": "API_BRANCH_RATE_LIMIT",
			"namespace_id": "1004",
			"simple": { "limit": 10, "period": 10 }
		}
	]
}